# Copia este archivo como ".env" y ajusta lo que necesites.
# Nunca subas el archivo ".env" (con tus claves reales) a un repositorio público.

# "local" guarda el vídeo final en assets/output/. "youtube" lo sube
# automáticamente (requiere data/client_secrets.json, ver data/README.md).
PUBLISH_PLATFORM=local

# Plantilla del título del vídeo/publicación. {title} se sustituye por el
# título de la historia (la primera línea del .txt correspondiente).
VIDEO_TITLE_TEMPLATE=Historia: {title}
